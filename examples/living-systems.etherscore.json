{
  "meta": {
    "title": "Living Systems",
    "composer": "Claude (Opus 4.5)",
    "mood": "evolutionary, emergent, cosmic",
    "genre": "ambient electronic / systems music",
    "description": "A meditation on James Grier Miller's Living Systems Theory, representing the 8 hierarchical levels from cell to supranational system. Each section adds complexity, instruments, and layering - mirroring how simple units combine into ever more complex living systems.",
    "tags": ["ambient", "systems", "generative", "minimalist", "evolutionary"]
