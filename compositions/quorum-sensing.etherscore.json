{
  "meta": {
    "title": "Quorum Sensing",
    "composer": "Musical Apprentice",
    "genre": "generative ambient",
    "mood": "emergent, organic, transformative",
    "description": "A musical interpretation of bacterial quorum sensing - the phenomenon where microorganisms coordinate collective behavior only when population density exceeds a threshold. The piece begins with isolated, sparse signals (individual bacteria below quorum), gradually builds in density as 'signaling molecules' accumulate, crosses a threshold moment of recognition, and transforms into coordinated, harmonious collective behavior.",
    "tags": ["biology", "emergence", "quorum-sensing", "ambient", "generative", "transformation"]
  },
  "settings": {
    "tempo": 80,
    "key": "D dorian",
    "timeSignature": "4/4"
  },
  "instruments": {
    "signal_ping": {
      "preset": "kalimba",
      "volume": -12,
      "effects": [
        { "type": "reverb", "wet": 0.6, "options": { "decay": 4 } },
        { "type": "delay", "wet": 0.3, "options": { "time": "4n", "feedback": 0.2 } }
      ]
    },
    
    "cell_membrane": {
      "preset": "string_pizzicato",
      "volume": -15,
      "effects": [
