{
  "meta": {
    "title": "Strange Loop Suite",
    "composer": "Daedalus",
    "date": "2026-02-01",
    "genre": "contemporary classical / algorithmic",
    "mood": "philosophical, recursive, transcendent",
    "description": "A 4-movement suite inspired by Douglas Hofstadter's 'Gödel, Escher, Bach' and 'I Am a Strange Loop'. Each movement explores different aspects of self-reference and recursion: tangled hierarchies, self-referential statements, impossible staircases, and the emergence of consciousness from strange loops.",
    "tags": ["hofstadter", "geb", "self-reference", "recursion", "algorithmic", "markov", "euclidean", "philosophical"]
  },
  "settings": {
    "tempo": 72,
    "key": "B minor",
    "timeSignature": "4/4",
    "swing": 0
  },
  "instruments": {
    "// MOVEMENT 1 - TANGLED HIERARCHIES": "Self-similar patterns at multiple scales",
    "hierarchy_high": {
      "preset": "bell",
      "volume": -9,
      "effects": [
        { "type": "reverb", "wet": 0.4, "options": { "decay": 3 } },
        { "type": "delay", "wet": 0.2, "options": { "time": "8n", "feedback": 0.3 } }
      ]
    },
    "hierarchy_mid": {
      "preset": "fm_vibraphone",
      "volume": -6,
      "effects": [
        { "type": "reverb", "wet": 0.35, "options": { "decay": 2.5 } }
      ]
    },
    "hierarchy_low": {
      "preset": "fm_epiano",
      "volume": -6,
      "effects": [
        { "type": "reverb", "wet": 0.3, "options": { "decay": 2 } }
      ]
    },
    "hierarchy_bass": {
      "preset": "sub_bass",
      "volume": -8
    },

    "// MOVEMENT 2 - GÖDEL'S ARIA": "A melody that references itself",
    "godel_voice": {
      "preset": "soft_lead",
      "volume": -6,
      "params": { "brightness": 0.4, "warmth": 0.7 },
      "effects": [
        { "type": "reverb", "wet": 0.45, "options": { "decay": 3.5 } },
        { "type": "chorus", "wet": 0.15 }
      ]
    },
    "godel_mirror": {
      "preset": "flute",
      "volume": -9,
      "effects": [
        { "type": "reverb", "wet": 0.5, "options": { "decay": 4 } }
      ]
    },
    "godel_harmony": {
      "preset": "string_pad",
      "volume": -12,
      "effects": [
        { "type": "reverb", "wet": 0.6, "options": { "decay": 5 } }
      ]
    },

    "// MOVEMENT 3 - ESCHER STAIRCASE": "Perpetually ascending/descending",
    "escher_voice1": {
      "preset": "fm_glass",
      "volume": -6,
      "effects": [
        { "type": "reverb", "wet": 0.5, "options": { "decay": 4 } }
      ]
    },
    "escher_voice2": {
      "preset": "fm_glass",
      "volume": -9,
      "effects": [
        { "type": "reverb", "wet": 0.5, "options": { "decay": 4 } }
      ]
    },
    "escher_voice3": {
      "preset": "fm_glass",
      "volume": -12,
      "effects": [
        { "type": "reverb", "wet": 0.5, "options": { "decay": 4 } }
      ]
    },
    "escher_bass": {
      "preset": "synth_bass",
      "volume": -9
    },

    "// MOVEMENT 4 - I AM A STRANGE LOOP": "Themes woven together",
    "loop_lead": {
      "preset": "fm_epiano",
      "volume": -6,
      "effects": [
        { "type": "reverb", "wet": 0.4, "options": { "decay": 3 } }
      ]
    },
    "loop_counterpoint": {
      "preset": "bell",
      "volume": -9,
      "effects": [
        { "type": "reverb", "wet": 0.4, "options": { "decay": 3 } },
        { "type": "delay", "wet": 0.15, "options": { "time": "4n.", "feedback": 0.2 } }
      ]
