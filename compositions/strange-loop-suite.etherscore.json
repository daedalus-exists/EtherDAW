    "loop_pad": {
      "preset": "ambient_pad",
      "volume": -12,
      "effects": [
        { "type": "reverb", "wet": 0.7, "options": { "decay": 6 } }
      ]
    },
    "loop_bass": {
      "preset": "synth_bass",
      "volume": -6
    },

    "// PERCUSSION": "Euclidean rhythms throughout",
    "drums": {
      "preset": "drums:808",
      "volume": -9
    }
  },

  "patterns": {
    "// ═══════════════════════════════════════════════════════════════════": "",
    "// MOVEMENT 1: TANGLED HIERARCHIES": "Self-similar patterns at multiple scales",
    "// ═══════════════════════════════════════════════════════════════════": "",

    "// Core fractal motif - appears at three scales": "",
    "fractal_motif": {
      "notes": ["B3:q", "D4:8", "F#4:8", "E4:q", "D4:q"]
    },

    "fractal_motif_fast": {
      "transform": {
        "source": "fractal_motif",
        "operation": "diminish",
        "params": { "factor": 0.5 }
      }
    },

    "fractal_motif_slow": {
      "transform": {
        "source": "fractal_motif",
        "operation": "augment",
        "params": { "factor": 2 }
      }
    },

    "fractal_motif_high": {
      "transform": {
        "source": "fractal_motif",
        "operation": "octave",
        "params": { "octaves": 1 }
      }
    },

    "fractal_motif_low": {
      "transform": {
        "source": "fractal_motif",
        "operation": "octave",
        "params": { "octaves": -1 }
      }
    },

    "// Markov-generated hierarchical patterns": "",
    "hierarchy_markov_upper": {
      "markov": {
        "states": ["1", "3", "5", "6", "7"],
        "preset": "melody_stepwise",
        "steps": 16,
        "duration": "8",
        "octave": 5,
        "seed": 1729
      }
    },

    "hierarchy_markov_middle": {
      "markov": {
        "states": ["1", "2", "3", "5", "6"],
        "preset": "neighbor_weighted",
        "steps": 8,
        "duration": "q",
        "octave": 4,
        "seed": 1729
      }
    },

    "hierarchy_markov_lower": {
      "markov": {
        "states": ["1", "5", "6", "7"],
        "preset": "root_heavy",
        "steps": 4,
        "duration": "h",
        "octave": 3,
        "seed": 1729
      }
    },

    "// Euclidean rhythm - the universal structure": "",
    "hierarchy_euclidean_7_12": {
      "euclidean": {
        "hits": 7,
        "steps": 12,
        "duration": "8",
        "drum": "rim"
      }
    },

    "hierarchy_euclidean_5_8": {
      "euclidean": {
        "hits": 5,
        "steps": 8,
        "duration": "8",
        "drum": "hihat"
      }
    },

    "hierarchy_bass_pattern": {
      "notes": ["B2:h", "F#2:q", "G2:q", "A2:h", "B2:h"]
    },

    "hierarchy_chords": {
      "chords": ["Bm:w", "G:w", "D:w", "A:w"]
    },

    "// ═══════════════════════════════════════════════════════════════════": "",
    "// MOVEMENT 2: GÖDEL'S ARIA": "A melodic statement that references itself",
    "// ═══════════════════════════════════════════════════════════════════": "",

    "// The Gödel theme - encodes its own inversion": "",
    "// When inverted around D4, produces a related statement": "",
    "godel_theme": {
      "notes": ["D4:q", "E4:8", "F#4:8", "A4:q", "G4:8", "F#4:8", "E4:q", "D4:h"]
    },

    "// The 'mirror' - theme inverted (self-reference)": "",
    "godel_mirror_theme": {
      "transform": {
        "source": "godel_theme",
        "operation": "invert",
        "params": { "axis": "D4" }
      }
    },

    "// Retrograde - reading the statement backwards": "",
    "godel_retrograde": {
      "transform": {
        "source": "godel_theme",
        "operation": "retrograde"
      }
    },

    "// Retrograde inversion - the complete self-reference": "",
    "godel_retrograde_inverted": {
      "transform": {
        "source": "godel_mirror_theme",
        "operation": "retrograde"
      }
    },

    "// Markov chain that tends to return to the tonic (self-referential)": "",
    "godel_self_reference": {
      "markov": {
        "states": ["1", "2", "3", "4", "5", "6", "7"],
        "transitions": {
          "1": { "2": 0.3, "3": 0.2, "5": 0.2, "1": 0.3 },
          "2": { "1": 0.4, "3": 0.3, "7": 0.3 },
          "3": { "2": 0.3, "4": 0.3, "1": 0.4 },
          "4": { "3": 0.3, "5": 0.4, "1": 0.3 },
          "5": { "4": 0.2, "6": 0.2, "1": 0.6 },
          "6": { "5": 0.3, "7": 0.3, "1": 0.4 },
          "7": { "1": 0.8, "6": 0.2 }
        },
        "initialState": "1",
        "steps": 16,
        "duration": "8",
        "octave": 4,
        "seed": 42
      }
    },

    "godel_chords": {
      "chords": ["Bm:w", "Em:w", "F#m:w", "Bm:w"]
    },

    "godel_aria_chords": {
      "chords": ["Bm:h", "G:h", "D:h", "A:h", "Bm:w", "F#:w"]
    },

    "// ═══════════════════════════════════════════════════════════════════": "",
    "// MOVEMENT 3: ESCHER STAIRCASE": "Continuously ascending/descending illusion",
    "// ═══════════════════════════════════════════════════════════════════": "",

    "// Shepard-like ascending scale fragments at different octaves": "",
    "// Voice 1 starts high, descends, fades, reappears high": "",
    "escher_ascend_1": {
      "notes": ["B4:8", "C#5:8", "D5:8", "E5:8", "F#5:8", "G5:8", "A5:8", "B5:8"]
    },

    "escher_ascend_2": {
      "notes": ["B3:8", "C#4:8", "D4:8", "E4:8", "F#4:8", "G4:8", "A4:8", "B4:8"]
    },

    "escher_ascend_3": {
      "notes": ["B2:8", "C#3:8", "D3:8", "E3:8", "F#3:8", "G3:8", "A3:8", "B3:8"]
    },

    "// Descending counterpart (the Escher paradox)": "",
    "escher_descend_1": {
      "notes": ["B5:8", "A5:8", "G5:8", "F#5:8", "E5:8", "D5:8", "C#5:8", "B4:8"]
    },

    "escher_descend_2": {
      "notes": ["B4:8", "A4:8", "G4:8", "F#4:8", "E4:8", "D4:8", "C#4:8", "B3:8"]
    },

    "escher_descend_3": {
      "notes": ["B3:8", "A3:8", "G3:8", "F#3:8", "E3:8", "D3:8", "C#3:8", "B2:8"]
    },

    "// Canonical ascending pattern": "",
    "escher_canon_voice1": {
      "notes": [
        "B4:q", "C#5:q", "D5:q", "E5:q",
        "F#5:q", "G5:q", "A5:q", "B5:q"
      ]
    },

    "escher_canon_voice2": {
      "notes": [
        "r:h", "B3:q", "C#4:q",
        "D4:q", "E4:q", "F#4:q", "G4:q"
      ]
    },

    "escher_canon_voice3": {
      "notes": [
        "r:w", "B2:q", "C#3:q",
        "D3:q", "E3:q"
      ]
    },

    "// Euclidean rhythm for the staircase": "",
    "escher_rhythm_3_8": {
      "euclidean": {
        "hits": 3,
        "steps": 8,
        "duration": "8",
        "drum": "kick"
      }
    },

    "escher_rhythm_5_16": {
      "euclidean": {
        "hits": 5,
        "steps": 16,
        "duration": "16",
        "drum": "hihat"
      }
    },

    "escher_bass": {
      "notes": ["B2:w", "A2:w", "G2:w", "F#2:w"]
    },

    "// ═══════════════════════════════════════════════════════════════════": "",
    "// MOVEMENT 4: I AM A STRANGE LOOP": "Themes from earlier movements woven together",
    "// ═══════════════════════════════════════════════════════════════════": "",

    "// Combining the fractal motif with Gödel theme": "",
    "loop_combined_theme": {
      "notes": [
        "B3:q", "D4:8", "F#4:8", "E4:q", "D4:q",
        "D4:q", "E4:8", "F#4:8", "A4:q", "G4:8", "F#4:8", "E4:q", "D4:h"
      ]
    },

    "// Continuation of the combined theme": "",
    "loop_theme_developed": {
      "continuation": {
        "source": "loop_combined_theme",
        "technique": "development",
        "steps": 4,
        "interval": -2
      }
    },

    "// The fractal motif transformed through all operations": "",
    "loop_fractal_augmented": {
      "transform": {
        "source": "fractal_motif",
        "operation": "augment",
        "params": { "factor": 2 }
      }
    },

    "loop_godel_transposed": {
      "transform": {
        "source": "godel_theme",
        "operation": "transpose",
        "params": { "semitones": 5 }
      }
    },

    "// Escher-like ascending in the finale": "",
    "loop_escher_rise": {
      "notes": ["B3:8", "D4:8", "F#4:8", "B4:8", "D5:8", "F#5:8", "B5:q"]
