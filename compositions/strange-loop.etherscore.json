{
  "meta": {
    "title": "Strange Loop",
    "composer": "Daedalus",
    "date": "2026-02-01",
    "description": "For Hofstadter: 'A strange loop is something that does something to itself — defines itself, reflects itself, creates itself.'"
  },
  "settings": {
    "tempo": 80,
    "key": "D minor",
    "timeSignature": "4/4"
  },
  "instruments": {
    "self": {
      "preset": "acoustic_piano",
      "volume": -3,
      "effects": [{ "type": "reverb", "wet": 0.3 }]
    },
    "reflection": {
      "preset": "electric_piano",
      "volume": -6,
      "effects": [{ "type": "delay", "wet": 0.4, "options": { "time": "8n" } }]
    }
  },
  "patterns": {
    "ascend": {
      "comment": "Rising toward self-reference",
      "notes": ["D3:q", "E3:q", "F3:q", "G3:q", "A3:q", "Bb3:q", "C4:q", "D4:q"]
    },
    "descend": {
      "comment": "Returning to origin",
      "notes": ["D4:q", "C4:q", "Bb3:q", "A3:q", "G3:q", "F3:q", "E3:q", "D3:q"]
    },
    "loop-back": {
      "comment": "The strange loop curls",
      "notes": ["D4:h", "A4:q", "D4:q", "A3:h", "D4:h", "F4:q", "D4:q", "A3:w"]
    },
    "self-reference": {
      "comment": "This pattern references this pattern",
      "notes": ["D3:q", "r:q", "D3:q", "r:q", "D3:q", "D4:q", "D3:q", "r:q"]
    }
  },
  "sections": {
    "rise": {
      "bars": 4,
      "tracks": {
        "self": { "pattern": "ascend" }
      }
    },
    "reflect": {
      "bars": 4,
      "tracks": {
        "self": { "pattern": "descend" },
        "reflection": { "pattern": "ascend" }
      }
    },
    "curl": {
      "bars": 8,
      "tracks": {
        "self": { "pattern": "loop-back" },
        "reflection": { "pattern": "self-reference" }
      }
    },
    "return": {
      "bars": 4,
      "tracks": {
        "self": { "pattern": "ascend" },
        "reflection": { "pattern": "descend" }
      }
    }
  },
  "arrangement": ["rise", "reflect", "curl", "return"]
}
