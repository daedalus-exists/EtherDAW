          "patterns": ["flower_theme", "flower_response", "flower_theme", "flower_response", "flower_theme", "flower_response", "flower_theme", "flower_response"],
          "velocity": 0.7
        },
        "growth": {
          "patterns": ["flower_pad", "flower_pad", "flower_pad", "flower_pad"],
          "velocity": 0.6
        },
        "bass": {
          "patterns": ["flower_bass", "flower_bass"],
