    "fib_13_climax": {
      "bars": 13,
      "tracks": {
        "spiral": {
          "patterns": ["climax_ascent", "climax_peak", "climax_peak", "climax_descent", "climax_ascent", "climax_peak", "climax_peak", "climax_descent", "climax_ascent", "climax_peak", "climax_descent", "coda_return", "coda_fade"],
          "velocity": 0.8
