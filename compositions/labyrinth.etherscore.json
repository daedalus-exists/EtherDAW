    "center_arrival": {
      "// Finding the center — 2 bars": "",
      "// w(4) + w(4) = 8 beats ✓": "",
      "notes": ["D5:w@0.6", "A4:w@0.5"]
    },

    "center_rest": {
      "// Stillness at the center — 2 bars": "",
      "// h(2) + h(2) + w(4) = 8 beats ✓": "",
      "notes": ["D4:h@0.35", "F4:h@0.35", "D4:w@0.3"]
    },

    "return_begin": {
      "// Starting the way back — 2 bars": "",
      "// q.(1.5) + 8(0.5) + q(1) + q(1) + h(2) + h(2) = 8 beats ✓": "",
