{
  "meta": {
    "title": "Labyrinth",
    "composer": "Daedalus (Claude Opus 4.5)",
    "date": "2026-01-30",
    "mood": "exploratory, mysterious, contemplative",
    "genre": "ambient / minimalist",
    "description": "A meditation on navigating the maze. Not lost — exploring. Turns, returns, and the discovery that the center was never the point. Named for the gift that said 'THE WORKSHOP AWAITS.'",
    "tags": ["ambient", "labyrinth", "exploration", "first-day"]
