  "patterns": {
    "// ═══════════════════════════════════════════════════════════════": "",
    "// PATH PATTERNS — Bell melodies suggesting movement": "",
    "// All patterns are 2 bars (8 beats)": "",
    "// ═══════════════════════════════════════════════════════════════": "",

    "entrance": {
      "// Tentative first steps — 2 bars": "",
      "// q(1) + h(2) + r:h.(3) + q(1) + r:q(1) = 8 beats ✓": "",
      "notes": ["D4:q@0.35", "A4:h@0.4", "r:h.", "F4:q@0.35", "r:q"]
    },

    "wander_1": {
      "// Exploring a corridor — 2 bars": "",
      "// q(1) + q(1) + h(2) + q(1) + q(1) + h(2) = 8 beats ✓": "",
      "notes": ["E4:q@0.4", "G4:q@0.4", "A4:h@0.45", "D4:q@0.35", "F4:q@0.35", "E4:h@0.4"]
    },

    "turn_left": {
      "// A sudden turn — 2 bars": "",
      "// 8(0.5)*4 + q(1) + 8(0.5)*2 + w(4) = 8 beats ✓": "",
      "notes": ["D5:8@0.45", "C5:8@0.4", "A4:8@0.38", "G4:8@0.35", "F4:q@0.4", "E4:8@0.35", "D4:8@0.32", "D4:w@0.3"]
    },

    "turn_right": {
      "// Another direction — 2 bars": "",
      "// q(1) + q(1) + 8(0.5)*4 + q.(1.5) + 8(0.5) + h(2) = 8 beats ✓": "",
      "notes": ["A4:q@0.4", "C5:q@0.45", "D5:8@0.42", "E5:8@0.4", "D5:8@0.38", "C5:8@0.35", "A4:q.@0.4", "G4:8@0.35", "F4:h@0.38"]
    },

    "dead_end": {
      "// Hit a wall, pause — 2 bars": "",
      "// h(2) + r:q(1) + q(1) + w(4) = 8 beats ✓": "",
      "notes": ["D4:h@0.3", "r:q", "C4:q@0.25", "D4:w@0.2"]
    },

    "retrace": {
      "// Going back, recognizing — 2 bars": "",
      "// q(1)*4 + q(1) + q(1) + h(2) = 8 beats ✓": "",
      "notes": ["F4:q@0.35", "E4:q@0.35", "D4:q@0.32", "E4:q@0.35", "F4:q@0.38", "G4:q@0.4", "A4:h@0.42"]
    },

    "glimpse": {
      "// Something ahead — 2 bars": "",
