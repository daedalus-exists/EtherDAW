{
  "meta": {
    "title": "Free Energy",
    "composer": "Daedalus",
    "mood": "tense, revelatory, transformative",
    "genre": "experimental ambient / generative",
    "description": "A musical exploration of the Free Energy Principle from Active Inference. The piece establishes strong predictions (stable patterns), then introduces controlled surprises (prediction errors), and resolves to a new equilibrium where the model has updated. Uses Markov chains to model prediction uncertainty and density curves to represent precision weighting.",
    "tags": ["active-inference", "free-energy-principle", "generative", "experimental", "philosophy-of-mind", "markov", "density-curves"]
  },
  "settings": {
    "tempo": 96,
    "key": "E minor",
    "timeSignature": "4/4",
    "swing": 0
  },
  "instruments": {
    "// PREDICTIVE LAYER": "The model's expectations - stable, clear",
    "prior": {
      "preset": "fm_glass",
      "volume": -8,
      "params": { "brightness": 0.6, "warmth": 0.4, "attack": 0.1, "release": 0.5 },
      "effects": [
        { "type": "delay", "wet": 0.3, "options": { "time": "8n", "feedback": 0.4 } },
        { "type": "reverb", "wet": 0.35, "options": { "decay": 2.5 } }
      ]
    },
    
    "// SENSORY LAYER": "The incoming data - can surprise",
    "sensory": {
      "preset": "soft_lead",
      "volume": -9,
      "params": { "brightness": 0.5, "warmth": 0.6, "attack": 0.05, "release": 0.4 },
      "effects": [
        { "type": "reverb", "wet": 0.4, "options": { "decay": 2 } },
        { "type": "chorus", "wet": 0.2, "options": { "frequency": 2, "depth": 0.5 } }
      ]
    },
    
    "// FREE ENERGY": "The tension, the error signal",
    "error_signal": {
      "preset": "fm_brass",
      "volume": -10,
      "params": { "brightness": 0.7, "warmth": 0.3, "punch": 0.6 },
      "effects": [
        { "type": "distortion", "wet": 0.15, "options": { "amount": 0.3 } },
        { "type": "reverb", "wet": 0.25, "options": { "decay": 1.5 } }
      ]
    },
    
    "// GROUNDING BASS": "The invariant structure",
    "bass": {
      "preset": "sub_bass",
      "volume": -6,
      "params": { "warmth": 0.8, "attack": 0.1, "release": 0.3 },
      "effects": [
        { "type": "filter", "options": { "frequency": 300, "type": "lowpass" } },
        { "type": "compressor", "options": { "threshold": -20, "ratio": 4 } }
      ]
    },
    
    "// HOMEOSTATIC PAD": "The background equilibrium state",
    "equilibrium": {
      "preset": "ambient_pad",
      "volume": -12,
      "params": { "brightness": 0.3, "warmth": 0.7, "attack": 0.8, "release": 0.9 },
      "effects": [
        { "type": "reverb", "wet": 0.7, "options": { "decay": 6 } },
        { "type": "phaser", "wet": 0.15, "options": { "frequency": 0.2 } }
      ]
    },
    
    "// NOISE/UNCERTAINTY": "Environmental noise, uncertainty",
    "noise": {
      "preset": "bell",
      "volume": -14,
      "params": { "brightness": 0.9, "attack": 0.01, "decay": 0.8, "release": 0.2 },
      "effects": [
        { "type": "reverb", "wet": 0.5, "options": { "decay": 3 } },
        { "type": "delay", "wet": 0.4, "options": { "time": "8n.", "feedback": 0.5 } }
      ]
    },
    
    "// PULSE": "Heartbeat - the living system's rhythm",
    "pulse": {
      "preset": "kick_deep",
      "volume": -10,
      "effects": []
    }
  },
  "patterns": {
    "// ========== PRIOR PATTERNS (PREDICTIONS) ==========": "---",
    
    "// Strong, predictable ostinato - the model's confident expectation": "---",
    "prior_ostinato": {
      "notes": [
        "E4:8", "G4:8", "B4:8", "E4:8",
        "E4:8", "G4:8", "B4:8", "E4:8"
      ]
    },
    
    "prior_confident": {
      "notes": [
        "E4:q", "G4:q", "B4:q", "E5:q"
      ]
    },
    
    "prior_stable": {
      "degrees": ["1:q", "3:q", "5:q", "1+:q"]
    },
    
    "// ========== MARKOV PREDICTION CHAINS ==========": "---",
    
    "// Tight Markov - high confidence, neighbor-weighted (predictable)": "---",
    "markov_tight": {
      "markov": {
        "states": ["1", "2", "3", "5"],
        "transitions": {
          "1": { "1": 0.3, "2": 0.5, "3": 0.15, "5": 0.05 },
          "2": { "1": 0.4, "2": 0.1, "3": 0.45, "5": 0.05 },
          "3": { "1": 0.1, "2": 0.4, "3": 0.2, "5": 0.3 },
          "5": { "1": 0.5, "2": 0.1, "3": 0.3, "5": 0.1 }
        },
        "initialState": "1",
        "steps": 16,
        "duration": "8",
        "octave": 4,
        "seed": 314159
      }
    },
    
    "// Loose Markov - low confidence, more uniform (surprising)": "---",
    "markov_loose": {
      "markov": {
        "states": ["1", "b2", "2", "b3", "3", "4", "#4", "5", "b6", "6", "b7", "7"],
        "transitions": {
          "1": { "b2": 0.12, "2": 0.15, "b3": 0.12, "3": 0.15, "4": 0.08, "#4": 0.08, "5": 0.12, "b6": 0.06, "6": 0.04, "b7": 0.04, "7": 0.04 },
          "b2": { "1": 0.3, "b3": 0.2, "5": 0.2, "b7": 0.15, "4": 0.15 },
          "2": { "1": 0.25, "3": 0.25, "5": 0.2, "b3": 0.15, "4": 0.15 },
          "b3": { "1": 0.2, "2": 0.2, "3": 0.2, "5": 0.2, "b7": 0.2 },
          "3": { "1": 0.2, "2": 0.2, "4": 0.15, "5": 0.25, "6": 0.1, "7": 0.1 },
          "4": { "1": 0.15, "3": 0.2, "#4": 0.2, "5": 0.25, "b3": 0.1, "6": 0.1 },
          "#4": { "5": 0.5, "4": 0.2, "6": 0.15, "1": 0.15 },
          "5": { "1": 0.25, "3": 0.15, "4": 0.15, "6": 0.15, "b7": 0.15, "7": 0.15 },
          "b6": { "5": 0.4, "1": 0.2, "b7": 0.2, "4": 0.2 },
          "6": { "5": 0.35, "7": 0.25, "1": 0.2, "4": 0.2 },
          "b7": { "1": 0.4, "5": 0.25, "b6": 0.15, "4": 0.2 },
          "7": { "1": 0.5, "5": 0.2, "6": 0.15, "3": 0.15 }
        },
        "initialState": "1",
        "steps": 24,
        "duration": "8",
        "octave": 4,
        "seed": 271828
      }
    },
    
    "// ========== SENSORY INPUT PATTERNS ==========": "---",
    
    "// Expected sensory input (matches predictions)": "---",
    "sensory_expected": {
      "notes": [
        "E5:q", "r:8", "D5:8", "E5:h"
      ]
    },
    
    "// Surprising sensory input (prediction errors)": "---",
    "sensory_surprise": {
      "notes": [
        "E5:8?0.9", "F5:8?0.4", "E5:8?0.8", "Eb5:8?0.3",
        "D5:8?0.7", "D#5:8?0.5", "E5:q?0.6"
      ]
    },
    
    "sensory_chaos": {
      "notes": [
        "F5:16?0.6", "E5:16?0.7", "F#5:16?0.4", "G5:16?0.5",
        "Eb5:16?0.5", "D5:16?0.6", "C#5:16?0.3", "D5:16?0.7",
        "E5:8?0.8", "A#4:8?0.3", "B4:8?0.6", "C5:8?0.4"
      ]
    },
    
    "// ========== ERROR SIGNAL PATTERNS ==========": "---",
    
