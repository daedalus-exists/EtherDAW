{
  "$schema": "../dist/etherscore.schema.json",
  "title": "The Path Ahead",
  "composer": "Daedalus",
  "description": "Inspired by world models — systems that generate the path ahead in real time. Like Genie 3, the music emerges, explores, and remembers.",
  "version": "1.0.0",
  "settings": {
    "tempo": 92,
    "key": "G major",
    "timeSignature": "4/4"
  },
  "instruments": {
    "prompt": {
      "preset": "fm_epiano",
      "volume": -8,
      "pan": 0,
      "effects": [
        {
          "type": "reverb",
          "wet": 0.35,
          "decay": 3.5
        }
      ],
      "comment": "The initial seed, like a text prompt"
    },
    "world": {
      "preset": "warm_pad",
      "volume": -10,
      "pan": 0,
      "effects": [
        {
          "type": "reverb",
          "wet": 0.5,
          "decay": 5
        }
      ],
      "comment": "The generated environment, harmonic foundation"
    },
    "path": {
      "preset": "glass_marimba",
      "volume": -9,
      "pan": 15,
      "effects": [
        {
          "type": "delay",
          "wet": 0.25,
          "time": "8",
          "feedback": 0.4
        },
        {
          "type": "reverb",
          "wet": 0.3,
          "decay": 2.5
        }
      ],
      "comment": "Exploration arpeggios, like walking through the world"
    },
    "memory": {
      "preset": "sample_cello",
      "volume": -11,
      "pan": 0,
      "effects": [
        {
          "type": "reverb",
          "wet": 0.4,
          "decay": 4
        }
      ],
      "comment": "Low strings for consistency, like Genie's memory"
    }
  },
  "patterns": {
    "// PROMPT PATTERNS": "The initial seed motif",
    "seed_motif": {
      "comment": "G-B-D-G arpeggio, the basic 'prompt'",
      "notes": [
        "G4:q",
        "B4:q",
        "D5:q",
        "G5:q"
      ]
    },
    "seed_answer": {
      "comment": "Answering phrase, D-G-B-D",
      "notes": [
        "D5:q",
        "G4:q",
        "B4:q",
        "D5:q"
      ]
    },
    "seed_expanded": {
      "comment": "Melodic statement, 4 beats: 0.5+0.5+1+1+1=4",
      "notes": [
        "G4:8",
        "A4:8",
        "B4:q",
        "D5:q",
        "B4:q"
      ]
    },
    "// WORLD PATTERNS": "Harmonic foundations",
    "world_G": {
      "notes": [
        "G2:w"
      ]
    },
    "world_C": {
      "notes": [
        "C3:w"
      ]
    },
    "world_D": {
      "notes": [
        "D3:w"
      ]
    },
    "world_Em": {
      "notes": [
        "E3:w"
      ]
    },
    "world_movement": {
      "comment": "G - D/F# - Em - C progression, 4 bars",
      "chords": [
        "Gmaj:w",
        "D/F#:w",
        "Em:w",
        "Cmaj:w"
      ]
    },
    "// PATH PATTERNS": "Exploration arpeggios",
    "path_G_arp": {
      "arpeggio": {
        "chord": "Gmaj",
        "duration": "16",
        "mode": "updown",
        "steps": 16,
        "octaves": 2
      }
    },
    "path_C_arp": {
      "arpeggio": {
        "chord": "Cmaj",
        "duration": "16",
        "mode": "updown",
        "steps": 16,
        "octaves": 2
      }
    },
    "path_D_arp": {
      "arpeggio": {
        "chord": "Dmaj",
        "duration": "16",
        "mode": "updown",
        "steps": 16,
        "octaves": 2
      }
    },
    "path_Em_arp": {
      "arpeggio": {
        "chord": "Em",
        "duration": "16",
        "mode": "updown",
        "steps": 16,
        "octaves": 2
      }
    },
    "path_markov": {
      "comment": "Emergent melody via Markov chain",
      "markov": {
        "states": [
          "1",
          "2",
          "3",
          "4",
          "5",
          "6"
        ],
        "preset": "melody_stepwise",
        "steps": 8,
        "duration": "8",
        "octave": 5,
        "seed": 2026
      }
    },
    "// STEPS PATTERNS": "Rhythmic motion",
    "// MEMORY PATTERNS": "Consistency, returning themes",
    "memory_G": {
      "notes": [
        "G2:w"
      ]
