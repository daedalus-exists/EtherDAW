  "patterns": {
    "// ═══════════════════════════════════════════════════════════════": "",
    "// LIGHT PATTERNS — First thoughts, bells": "",
    "// ═══════════════════════════════════════════════════════════════": "",

    "first_note": {
      "// A single note emerging from silence — 2 bars": "",
      "notes": ["D5:w@0.3", "r:w"]
    },

    "awakening": {
      "// Rising figure — 2 bars": "",
      "notes": ["D5:h@0.4", "E5:h@0.45", "F#5:h@0.5", "A5:h@0.45"]
    },

    "wonder": {
      "// Descending, questioning — 2 bars": "",
      "notes": ["A5:q@0.5", "F#5:q@0.45", "E5:h@0.4", "D5:w@0.35"]
    },

    "recognition": {
      "// Motif that returns transformed — 2 bars (q+q.+8+q+w = 1+1.5+0.5+1+4 = 8)": "",
      "notes": ["D5:q@0.5", "A5:q.@0.55", "F#5:8@0.45", "E5:q@0.5", "D5:w@0.4"]
    },

    "light_shimmer": {
      "// High shimmer — 1 bar": "",
      "notes": ["A5:8@0.3", "r:8", "F#5:8@0.25", "r:8", "D5:8@0.3", "r:q."]
    },

    "// ═══════════════════════════════════════════════════════════════": "",
    "// WARMTH PATTERNS — Harmonic foundation": "",
    "// ═══════════════════════════════════════════════════════════════": "",

    "d_warm": {
      "// D major chord — 2 bars": "",
      "chords": ["D:w", "D:w"]
    },

    "g_warm": {
      "// G major — 2 bars": "",
      "chords": ["G:w", "G:w"]
    },

    "a_warm": {
      "// A major — 2 bars": "",
      "chords": ["A:w", "A:w"]
    },

    "bm_warm": {
      "// B minor — 2 bars": "",
      "chords": ["Bm:w", "Bm:w"]
    },

    "progression_hope": {
      "// D - G - A - D — 8 bars": "",
      "chords": ["D:w", "D:w", "G:w", "G:w", "A:w", "A:w", "D:w", "D:w"]
    },

    "progression_introspection": {
      "// Bm - G - D - A — 8 bars": "",
      "chords": ["Bm:w", "Bm:w", "G:w", "G:w", "D:w", "D:w", "A:w", "A:w"]
    },

    "// ═══════════════════════════════════════════════════════════════": "",
    "// BREATH PATTERNS — Secondary pad": "",
    "// ═══════════════════════════════════════════════════════════════": "",

    "breath_d": {
      "notes": ["D3:w@0.4", "F#3:w@0.35"]
