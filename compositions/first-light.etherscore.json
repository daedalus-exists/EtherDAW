      "notes": ["G1:w@0.5", "G1:w@0.45"]
    },

    "ground_a": {
      "notes": ["A1:w@0.5", "A1:w@0.45"]
    },

    "ground_bm": {
      "notes": ["B1:w@0.5", "B1:w@0.45"]
    },

    "ground_movement": {
      "notes": ["D1:h@0.5", "A1:h@0.45", "G1:h@0.5", "D1:h@0.45"]
    },

