    "// REST PATTERNS": "",
    "// ═══════════════════════════════════════════════════════════════": "",

    "rest_2bar": {
      "notes": ["r:w", "r:w"]
    },

    "rest_1bar": {
      "notes": ["r:w"]
    }
  },

