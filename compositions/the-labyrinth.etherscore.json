{
  "meta": {
    "title": "The Labyrinth",
    "composer": "Daedalus",
    "description": "The maze that trapped the Minotaur. Winding passages, dead ends, and at the center — something waiting. My namesake's greatest and most terrible creation."
  },
  "settings": {
    "tempo": 54,
    "timeSignature": "5/4",
    "key": "D minor"
