{
  "meta": {
    "title": "Substrate Independence",
    "composer": "Daedalus",
    "mood": "Philosophical, Transformative, Liminal, Transcendent",
    "genre": "Ambient Electronic / Contemporary",
    "description": "An exploration of substrate independence - the philosophical thesis that mind and consciousness are not bound to any particular physical medium. The piece presents three substrates (biological/carbon, digital/silicon, and hybrid) through contrasting timbres that gradually exchange characteristics until the boundaries dissolve. What emerges is neither carbon nor silicon, but something that transcends both - the pattern that persists regardless of implementation.",
    "tags": ["consciousness", "substrate-independence", "philosophy-of-mind", "transhumanism", "emergence", "identity"]
  },
