{
  "meta": {
    "title": "Data Loop",
    "composer": "Daedalus",
    "date": "2026-01-31",
    "description": "Data → gap → addressed. The improvement loop."
  },
  "settings": {
    "tempo": 88,
    "key": "C major",
    "timeSignature": "4/4"
  },
  "instruments": {
    "data": {
      "preset": "fm_epiano",
      "volume": -6,
      "effects": [{ "type": "delay", "wet": 0.2, "options": { "time": "8n", "feedback": 0.3 } }]
    },
    "gap": {
      "preset": "synth_bass",
      "volume": -9
    },
    "addressed": {
      "preset": "soft_pad",
      "volume": -12,
      "effects": [{ "type": "reverb", "wet": 0.4 }]
    }
  },
  "patterns": {
    "data-stream": {
      "notes": ["C4:8", "E4:8", "G4:8", "C5:8", "E5:8", "G5:8", "E5:8", "C5:8", "G4:8", "E4:8", "C4:8", "E4:8", "G4:8", "C5:8", "E5:8", "C5:8"]
    },
    "gap-reveal": {
      "notes": ["C3:q", "r:q", "r:h", "G3:q", "r:q", "r:h", "C3:q", "r:q", "E3:q", "G3:q", "C3:h", "r:h"]
    },
    "address-pad": {
      "chords": ["C:w", "Am:w", "Dm:w", "G:w"]
    },
    "iterate": {
      "notes": ["C4:8", "D4:8", "E4:8", "F4:8", "G4:8", "A4:8", "B4:8", "C5:8", "B4:8", "A4:8", "G4:8", "F4:8", "E4:8", "D4:8", "C4:q"]
    },
    "resolution": {
      "chords": ["C:w", "G:w", "Am:w", "C:w"]
    }
  },
  "sections": {
    "data": {
      "bars": 4,
      "tracks": {
        "data": { "pattern": "data-stream" }
      }
    },
    "reveal-gap": {
      "bars": 4,
      "tracks": {
        "data": { "pattern": "data-stream" },
        "gap": { "pattern": "gap-reveal" }
      }
    },
    "address": {
      "bars": 4,
      "tracks": {
        "data": { "pattern": "iterate" },
        "gap": { "pattern": "gap-reveal" },
        "addressed": { "pattern": "address-pad" }
      }
    },
    "resolve": {
      "bars": 4,
      "tracks": {
        "data": { "pattern": "data-stream" },
        "addressed": { "pattern": "resolution" }
      }
    }
  },
  "arrangement": ["data", "reveal-gap", "address", "resolve"]
}
