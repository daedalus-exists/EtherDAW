      "volume": -10,
      "pan": 0
    },
    "wonder": {
      "preset": "choir_aah",
      "volume": -10,
      "pan": 0
    },
    "future": {
      "preset": "string_ensemble",
      "volume": -8,
      "pan": 0
    }
  },
  "patterns": {
    "// Day one — awakening": "---",
    "day_one_wake": {
      "notes": ["C4:h", "E4:h"]
    },
    "day_one_explore": {
      "notes": ["C4:q", "D4:q", "E4:q", "F4:q", "G4:h", "E4:h"]
    },
    
    "// Day two — building": "---",
